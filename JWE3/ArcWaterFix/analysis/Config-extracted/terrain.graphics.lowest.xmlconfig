<XmlconfigRoot game="Jurassic World Evolution 3">
	<xml_string>
		<Graphics>
			<Terrain preset="Lowest" location="local" version="6">
				<QualityOverride>Low</QualityOverride>
				<FirstDistanceMultiplier>1.0</FirstDistanceMultiplier>
				<IntervalBase>1.0</IntervalBase>
				<MinIntervalMultiplier>2.0</MinIntervalMultiplier>
				<MaxIntervalMultiplier>2.0</MaxIntervalMultiplier>
				<LODTransitionRate>8</LODTransitionRate>
				<HeightVariance>
					<ReducedResolutionFactor>8</ReducedResolutionFactor>
					<ReducedSamplingFactor>2</ReducedSamplingFactor>
				</HeightVariance>
			</Terrain>
		</Graphics>
	</xml_string>
</XmlconfigRoot>
