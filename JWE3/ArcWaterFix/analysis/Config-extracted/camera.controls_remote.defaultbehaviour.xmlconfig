<XmlconfigRoot game="Jurassic World Evolution 3">
	<xml_string>
		<Controls_remote>
			<Camera preset="Default" default="true" version="5">
				<Inversions>
					<General>
						<InvertY>false</InvertY>
						<InvertX>false</InvertX>
						<InvertYGamepad>false</InvertYGamepad>
						<InvertXGamepad>false</InvertXGamepad>
					</General>
					<Jeep>
						<InvertY>false</InvertY>
						<InvertX>false</InvertX>
						<InvertYGamepad>false</InvertYGamepad>
						<InvertXGamepad>false</InvertXGamepad>
					</Jeep>
					<Helicopter>
						<InvertY>false</InvertY>
						<InvertX>false</InvertX>
						<InvertYGamepad>false</InvertYGamepad>
						<InvertXGamepad>false</InvertXGamepad>
					</Helicopter>
					<Gunner>
						<InvertY>false</InvertY>
						<InvertX>false</InvertX>
						<InvertYGamepad>false</InvertYGamepad>
						<InvertXGamepad>false</InvertXGamepad>
					</Gunner>
					<PhotoMode>
						<InvertY>false</InvertY>
						<InvertX>false</InvertX>
						<InvertYGamepad>false</InvertYGamepad>
						<InvertXGamepad>false</InvertXGamepad>
					</PhotoMode>
					<Gyrosphere>
						<InvertY>false</InvertY>
						<InvertX>false</InvertX>
						<InvertYGamepad>false</InvertYGamepad>
						<InvertXGamepad>false</InvertXGamepad>
					</Gyrosphere>
					<Capture>
						<InvertY>false</InvertY>
						<InvertX>false</InvertX>
						<InvertYGamepad>false</InvertYGamepad>
						<InvertXGamepad>false</InvertXGamepad>
					</Capture>
					<Guest>
						<InvertY>false</InvertY>
						<InvertX>false</InvertX>
						<InvertYGamepad>false</InvertYGamepad>
						<InvertXGamepad>false</InvertXGamepad>
					</Guest>
				</Inversions>
				<InvertYGunner>false</InvertYGunner>
				<PhysicsRaycasts>true</PhysicsRaycasts>
				<FreelookSpace>Mixed</FreelookSpace>
				<RotateFocus>Centre</RotateFocus>
				<ZoomFocus>Centre</ZoomFocus>
				<EdgePan>Circular</EdgePan>
				<RMBDrag>Simple</RMBDrag>
				<GuestCamSprintIsToggle>false</GuestCamSprintIsToggle>
				<GuestCamCrouchIsToggle>false</GuestCamCrouchIsToggle>
			</Camera>
		</Controls_remote>
	</xml_string>
</XmlconfigRoot>
