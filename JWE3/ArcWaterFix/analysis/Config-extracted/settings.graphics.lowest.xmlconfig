<XmlconfigRoot game="Jurassic World Evolution 3">
	<xml_string>
		<Graphics>
			<Settings preset="Lowest" location="local" version="14">
				<EffectQuality>0</EffectQuality>
				<TextureQuality>Medium</TextureQuality>
				<AOQualitySetting>1</AOQualitySetting>
				<FullScreenAAQuality>FSR3</FullScreenAAQuality>
				<FSR3Quality>Performance</FSR3Quality>
				<FSR3Sharpness>0.25</FSR3Sharpness>
				<TemporalUpscalingResolution>Off</TemporalUpscalingResolution>
				<AtmosphericsQuality>1</AtmosphericsQuality>
				<GeometricQuality>Low</GeometricQuality>
				<DetailObjectQuality>Low</DetailObjectQuality>
				<WaterQuality>0</WaterQuality>
				<WindQuality>0</WindQuality>
				<RainQuality>0</RainQuality>
				<PostProcessQuality>1</PostProcessQuality>
				<ScreenSpaceReflection>0</ScreenSpaceReflection>
				<MotionBlur>0</MotionBlur>
				<DepthOfField>0</DepthOfField>
				<MaxAnisotropicLevel>1</MaxAnisotropicLevel>
				<DirectionalShadows>
					<Quality>1</Quality>
					<CullingDistance>1000.0</CullingDistance>
					<Variance>
						<Resolution>256</Resolution>
						<SuperSampling>2</SuperSampling>
						<Threshold>0.97</Threshold>
						<DepthBias>-0.003</DepthBias>
						<SlopeBias>3.5</SlopeBias>
					</Variance>
					<CascadeCount>0</CascadeCount>
				</DirectionalShadows>
			</Settings>
		</Graphics>
	</xml_string>
</XmlconfigRoot>
