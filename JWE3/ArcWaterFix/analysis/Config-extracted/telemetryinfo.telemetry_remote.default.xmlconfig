<XmlconfigRoot game="Jurassic World Evolution 3">
	<xml_string>
		<Telemetry_remote>
			<TelemetryInfo preset="Default" version="1">
				<EngineFilters>
					<Filter>
						<Name>Diagnostics</Name>
						<Enabled>true</Enabled>
					</Filter>
					<Filter>
						<Name>Marketing</Name>
						<Enabled>false</Enabled>
					</Filter>
					<Filter>
						<Name>Rendering</Name>
						<Enabled>true</Enabled>
					</Filter>
					<Filter>
						<Name>Animation</Name>
						<Enabled>true</Enabled>
					</Filter>
					<Filter>
						<Name>Error</Name>
						<Enabled>true</Enabled>
					</Filter>
					<Filter>
						<Name>Physics</Name>
						<Enabled>true</Enabled>
					</Filter>
					<Filter>
						<Name>Audio</Name>
						<Enabled>true</Enabled>
					</Filter>
				</EngineFilters>
				<GameFilters>
					<Filter>
						<Name>Dinosaurs</Name>
						<Enabled>true</Enabled>
					</Filter>
					<Filter>
						<Name>Fossils</Name>
						<Enabled>true</Enabled>
					</Filter>
					<Filter>
						<Name>Buildings</Name>
						<Enabled>true</Enabled>
					</Filter>
					<Filter>
						<Name>Missions</Name>
						<Enabled>true</Enabled>
					</Filter>
					<Filter>
						<Name>Calamity</Name>
						<Enabled>true</Enabled>
					</Filter>
					<Filter>
						<Name>Vehicle</Name>
						<Enabled>true</Enabled>
					</Filter>
					<Filter>
						<Name>Research</Name>
						<Enabled>true</Enabled>
					</Filter>
				</GameFilters>
			</TelemetryInfo>
		</Telemetry_remote>
	</xml_string>
</XmlconfigRoot>
