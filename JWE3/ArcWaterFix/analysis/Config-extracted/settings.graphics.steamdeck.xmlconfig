<XmlconfigRoot game="Jurassic World Evolution 3">
	<xml_string>
		<Graphics>
			<Settings preset="SteamDeck" location="local" version="14">
				<EffectQuality>1</EffectQuality>
				<TextureQuality>High</TextureQuality>
				<LightPropagationVolumeQuality>0</LightPropagationVolumeQuality>
				<AOQualitySetting>1</AOQualitySetting>
				<FullScreenAAQuality>FSR3</FullScreenAAQuality>
				<FSR3Quality>Quality</FSR3Quality>
				<FSR3Sharpness>0.75</FSR3Sharpness>
				<TemporalUpscalingResolution>Off</TemporalUpscalingResolution>
				<AtmosphericsQuality>2</AtmosphericsQuality>
				<GeometricQuality>Medium</GeometricQuality>
				<DetailObjectQuality>Medium</DetailObjectQuality>
				<WaterQuality>1</WaterQuality>
				<WindQuality>1</WindQuality>
				<RainQuality>1</RainQuality>
				<PostProcessQuality>2</PostProcessQuality>
				<ScreenSpaceReflection>0</ScreenSpaceReflection>
				<DepthOfField>0</DepthOfField>
				<MaxAnisotropicLevel>2</MaxAnisotropicLevel>
				<DirectionalShadows>
					<Quality>3</Quality>
					<CullingDistance>1000.0</CullingDistance>
					<Variance>
						<Resolution>256</Resolution>
						<SuperSampling>4</SuperSampling>
						<Threshold>0.97</Threshold>
						<DepthBias>-0.003</DepthBias>
						<SlopeBias>3.5</SlopeBias>
					</Variance>
					<CascadeCount>3</CascadeCount>
					<CascadeResolution>768</CascadeResolution>
					<Cascade>
						<Index>0</Index>
						<Distance>20.0</Distance>
						<SlopeBias>2.5</SlopeBias>
					</Cascade>
					<Cascade>
						<Index>1</Index>
						<Distance>80.0</Distance>
						<SlopeBias>2.5</SlopeBias>
					</Cascade>
					<Cascade>
						<Index>2</Index>
						<Distance>240.0</Distance>
						<SlopeBias>2.5</SlopeBias>
					</Cascade>
				</DirectionalShadows>
				<ScreenSpaceShadows>1</ScreenSpaceShadows>
			</Settings>
		</Graphics>
	</xml_string>
</XmlconfigRoot>
