<XmlconfigRoot game="Jurassic World Evolution 3">
	<xml_string>
		<Graphics>
			<Settings preset="Ultra" location="local" version="14">
				<EffectQuality>2</EffectQuality>
				<TextureQuality>High</TextureQuality>
				<AOQualitySetting>3</AOQualitySetting>
				<FullScreenAAQuality>TAA</FullScreenAAQuality>
				<TemporalUpscalingResolution>Off</TemporalUpscalingResolution>
				<AtmosphericsQuality>3</AtmosphericsQuality>
				<GeometricQuality>VeryHigh</GeometricQuality>
				<DetailObjectQuality>VeryHigh</DetailObjectQuality>
				<WaterQuality>3</WaterQuality>
				<WindQuality>1</WindQuality>
				<RainQuality>1</RainQuality>
				<PostProcessQuality>2</PostProcessQuality>
				<ScreenSpaceReflection>2</ScreenSpaceReflection>
				<MotionBlur>0</MotionBlur>
				<DepthOfField>0</DepthOfField>
				<GlobalIlluminationQuality>Ultra</GlobalIlluminationQuality>
				<MaxAnisotropicLevel>4</MaxAnisotropicLevel>
				<DirectionalShadows>
					<Quality>5</Quality>
					<CullingDistance>1000.0</CullingDistance>
					<Variance>
						<Resolution>512</Resolution>
						<SuperSampling>4</SuperSampling>
						<Threshold>0.97</Threshold>
						<DepthBias>-0.003</DepthBias>
						<SlopeBias>3.5</SlopeBias>
					</Variance>
					<CascadeCount>4</CascadeCount>
					<CascadeResolution>2048</CascadeResolution>
					<Cascade>
						<Index>0</Index>
						<Distance>16.0</Distance>
						<SlopeBias>3.5</SlopeBias>
					</Cascade>
					<Cascade>
						<Index>1</Index>
						<Distance>48.0</Distance>
						<SlopeBias>3.5</SlopeBias>
					</Cascade>
					<Cascade>
						<Index>2</Index>
						<Distance>144.0</Distance>
						<SlopeBias>3.5</SlopeBias>
					</Cascade>
					<Cascade>
						<Index>3</Index>
						<Distance>432.0</Distance>
						<SlopeBias>3.5</SlopeBias>
					</Cascade>
				</DirectionalShadows>
				<ScreenSpaceShadows>1</ScreenSpaceShadows>
			</Settings>
		</Graphics>
	</xml_string>
</XmlconfigRoot>
