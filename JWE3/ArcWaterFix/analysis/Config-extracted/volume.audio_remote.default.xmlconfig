<XmlconfigRoot game="Jurassic World Evolution 3">
	<xml_string>
		<Audio_remote>
			<Volume preset="Default" version="9">
				<Volume>100</Volume>
				<SFXVolume>100</SFXVolume>
				<MusicVolume>100</MusicVolume>
				<VoiceVolume>100</VoiceVolume>
				<AudioMastering>3</AudioMastering>
				<MuteCarRadio>false</MuteCarRadio>
				<VOBoost>false</VOBoost>
				<Rumble>true</Rumble>
				<MuteLicensedMusic>false</MuteLicensedMusic>
				<EnableSubtitles>false</EnableSubtitles>
				<EnableCareerIntroductions>false</EnableCareerIntroductions>
				<MonoMode>false</MonoMode>
				<ControllerSpeaker>true</ControllerSpeaker>
			</Volume>
		</Audio_remote>
	</xml_string>
</XmlconfigRoot>
